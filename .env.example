# ═══════════════════════════════════════════════════════════
#  FRONTEND .env (loyiha ildizi — Bindy/.env)
#  Faqat Vite uchun. Gemma kaliti BU YERDA EMAS!
# ═══════════════════════════════════════════════════════════

# ── Variant 1: Kompyuteringizda dev (npm run dev) ──────────
# VITE_API_URL yozmasangiz ham bo‘ladi — Vite /api ni
# avtomatik localhost:8000 ga yo‘naltiradi (proxy).
# Shuning uchun dev da fayl deyarli bo‘sh bo‘lishi NORMAL.

# ── Variant 2: Tailscale / telefon / boshqa qurilmadan ───
# Proxy ishlamaydi — server manzilini yozing:
# VITE_API_URL=https://servicehub-server.tail5903af.ts.net

# ── Variant 3: Production build (npm run build) ────────────
# VITE_API_URL=https://servicehub-server.tail5903af.ts.net
