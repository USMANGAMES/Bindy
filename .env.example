# Bindy frontend — loyiha ildiziga `.env` nomi bilan nusxa oling
# cp .env.example .env

# Sizning Gemma backend serveringiz (Tailscale IP yoki domain)
# Masalan: http://100.x.x.x:8000 yoki https://bindy-api.tailXXXX.ts.net
VITE_API_URL=http://localhost:8000

# Backend serveringizda (Gemma) quyidagilar kerak — frontend emas:
# GEMMA_MODEL_PATH=/path/to/gemma
# GEMMA_HOST=0.0.0.0
# GEMMA_PORT=8000
# DATABASE_URL=postgresql://...
# CORS_ORIGINS=http://localhost:5173,http://100.x.x.x:5173
